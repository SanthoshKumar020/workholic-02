# ============================================================
# HYRISE — environment variables
# Copy this file to .env.local and fill in the real values.
#
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# All others are SERVER-ONLY — never expose them client-side.
#
# IMPORTANT: .env.local is for LOCAL dev only. On Vercel you must set
# every one of these in Project → Settings → Environment Variables
# (scope: Production). A missing var on Vercel falls back to a default
# and can break auth/payments even when local works.
# Do NOT add trailing spaces after a value — they corrupt secrets.
# ============================================================

# ── App URLs ──────────────────────────────────────────────────
# Your live domain. Both are used across the app (payments, emails,
# canonical URLs). Keep them identical in production.
NEXT_PUBLIC_APP_URL=https://hyrise.swache.in
NEXT_PUBLIC_SITE_URL=https://hyrise.swache.in

# ── Admin panel proxy (optional) ─────────────────────────────
# The admin app (in the /admin folder) deploys as its own Vercel project.
# Set this to its deployment URL to serve it at hyrise.swache.in/admin.
# Leave blank to disable the /admin proxy. Server-only.
ADMIN_ORIGIN=https://hyrise-admin.vercel.app

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY        # server-only

# ── Groq (AI) ────────────────────────────────────────────────
# https://console.groq.com → API Keys
# Add MULTIPLE keys to spread load and survive rate limits — requests
# round-robin across them and fail over to the next key on 429/401/5xx.
# Use a comma-separated list (preferred):
GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three            # server-only
# A single key still works too (merged into the pool):
GROQ_API_KEY=YOUR_GROQ_API_KEY                                 # server-only

# ── Cashfree (payments — active provider) ────────────────────
# https://merchant.cashfree.com → Developers → API Keys
# App ID and Secret MUST be from the SAME environment + account.
# A production secret (cfsk_..._prod_...) requires NEXT_PUBLIC_CASHFREE_ENV=production
# AND an activated/KYC-approved Cashfree account, or you get a 401.
CASHFREE_APP_ID=YOUR_CASHFREE_APP_ID                           # server-only
CASHFREE_SECRET_KEY=YOUR_CASHFREE_SECRET_KEY                   # server-only (no trailing spaces!)
NEXT_PUBLIC_CASHFREE_ENV=production                            # "production" | "sandbox"

# ── UPI manual approval (fallback payment flow) ──────────────
UPI_APPROVE_SECRET=A_RANDOM_PRIVATE_SECRET                     # server-only

# ── Resend (email) ───────────────────────────────────────────
# https://resend.com → API Keys
RESEND_API_KEY=YOUR_RESEND_API_KEY                            # server-only
EMAIL_FROM=HYRISE <onboarding@resend.dev>                     # verified sender

# ── YouTube Data API v3 ──────────────────────────────────────
# https://console.cloud.google.com → enable "YouTube Data API v3"
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY                          # server-only

# ── Vercel Cron secret ───────────────────────────────────────
# A random secret you generate (e.g. openssl rand -hex 32).
# Protects /api/cron/job-alerts.
CRON_SECRET=YOUR_CRON_SECRET                                  # server-only

# ── Super admins (always treated as Pro, comma-separated) ────
SUPER_ADMIN_EMAILS=you@example.com                            # server-only

# ── Stripe (OPTIONAL — only if you also enable Stripe) ───────
# Leave blank if you use Cashfree only.
STRIPE_SECRET_KEY=                                            # server-only
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=                                             # monthly price id
STRIPE_PRICE_ID_YEARLY=                                      # yearly price id
STRIPE_WEBHOOK_SECRET=                                       # server-only

# ── Analytics (OPTIONAL, both free) ──────────────────────────
# Set either or both. With neither set, no analytics script is
# loaded and every track() call is a silent no-op.
#
# Google Analytics 4 — free, unlimited: https://analytics.google.com
NEXT_PUBLIC_GA_ID=                                           # e.g. G-XXXXXXXXXX
# Plausible — privacy-friendly, paid cloud or free self-hosted
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                                # e.g. hyrise.swache.in

# ── Google Search Console verification ───────────────────────
# Search Console → Add property → HTML tag → copy the content value.
NEXT_PUBLIC_GOOGLE_VERIFICATION=

# ── SMTP (for outreach sent from your own address) ──────────
# SMTP is a protocol, not a paid product. Free options, July 2026:
#
# 1. RESEND — you already have a key, no new signup needed:
#      SMTP_HOST=smtp.resend.com
#      SMTP_PORT=587
#      SMTP_USER=resend            (literally the word "resend")
#      SMTP_PASS=<your RESEND_API_KEY>
#    Free ~3,000/month. Needs swache.in verified in Resend (DNS only, free).
#
# 2. YOUR EXISTING HOSTING — if swache.in email is on cPanel etc., SMTP is
#    already included free. Usually mail.swache.in:587. Check this first.
#
# 3. BREVO — 300/day free forever, smtp-relay.brevo.com:587, no card.
#
# 4. ZOHO MAIL — free plan NO LONGER includes SMTP; needs Mail Lite (~$1/mo).
#
# Always use an APP PASSWORD or API key here, never an account login password.
SMTP_HOST=                                                   # smtp.resend.com | mail.swache.in | smtp-relay.brevo.com
SMTP_PORT=587                                                # 465 for implicit TLS
SMTP_USER=                                                   # admin@swache.in, or "resend" for Resend's relay
SMTP_PASS=                                                   # app password / API key — server-only
SMTP_FROM=                                                   # "Santhosh Kumar <admin@swache.in>"

# ── Company identifiers (public, shown in the footer) ────────
# CIN display is a statutory requirement under s.12(3)(c) of the
# Companies Act 2013. Both are public information — safe as NEXT_PUBLIC_.
NEXT_PUBLIC_COMPANY_CIN=                                     # e.g. U62099KA2025OPC123456
NEXT_PUBLIC_COMPANY_GSTIN=                                   # once registered

# ── Gemini — second free AI lane (OPTIONAL but recommended) ──
# Groq free tier is 30 req/min and 1,000/day. Gemini adds ~1,500/day with
# no card, so running both roughly triples the ceiling for free. When a
# Reddit post or college WhatsApp group sends a burst, this is what stops
# every visitor past the limit seeing a broken tool.
# Get a key free at https://aistudio.google.com/apikey
GEMINI_API_KEY=                                              # server-only
