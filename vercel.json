{
  "crons": [
    {
      "path": "/api/cron/job-alerts",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/marketing-report",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/newsletter",
      "schedule": "0 8 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
